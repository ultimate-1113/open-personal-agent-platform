{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opap-google-gatekeeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "development",
    "CREDENTIAL_KEY_ID": "kek:development",
    "GMAIL_DRAFT_ALLOWED_RECIPIENTS": ""
  },
  "d1_databases": [{
    "binding": "GATEKEEPER_DB",
    "database_name": "opap-google-gatekeeper-development",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../migrations/gatekeeper"
  }]
}
