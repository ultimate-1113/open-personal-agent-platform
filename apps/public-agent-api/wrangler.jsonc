{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opap-public-agent-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "development",
    "DEPLOYMENT_ID": "deployment:default",
    "PUBLIC_SOURCES_JSON": "[{\"sourceId\":\"source:public-fixture\",\"kind\":\"fixture\",\"revision\":\"1\",\"cacheTtlSeconds\":300},{\"sourceId\":\"source:public-ai-search\",\"kind\":\"ai-search\",\"transport\":\"workers-binding\",\"revision\":\"okidev-web-2026-08-vector-v3\",\"cacheTtlSeconds\":300,\"title\":\"OkiDev public documentation\",\"retrievalPolicy\":{\"retrievalType\":\"vector\",\"candidateResults\":10,\"matchThreshold\":0.4,\"contextExpansion\":1,\"answerContextCharacters\":4000,\"answerMaxOutputTokens\":4096,\"answerReasoningEffort\":\"low\"}},{\"sourceId\":\"source:public-ai-search-rules\",\"kind\":\"ai-search\",\"transport\":\"workers-binding\",\"revision\":\"okidev-web-rules-2026-08-vector-v3\",\"cacheTtlSeconds\":300,\"title\":\"OkiDev public rules\",\"retrievalPolicy\":{\"retrievalType\":\"vector\",\"candidateResults\":10,\"matchThreshold\":0.3,\"contextExpansion\":1,\"answerContextCharacters\":4000,\"answerMaxOutputTokens\":4096,\"answerReasoningEffort\":\"low\"}}]",
    "PRICING_CATALOG_VERIFIED_AT": "2026-08-07T00:00:00.000Z",
    "AI_MONTHLY_OVERAGE_USD": "5",
    "AI_GATEWAY_ID": "default",
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  "ai": { "binding": "AI" },
  "ai_search": [
    { "binding": "AI_SEARCH", "instance_name": "okidev-web", "remote": true }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLIC_QUOTA",
        "class_name": "QuotaDurableObject",
        "script_name": "opap-quota"
      }
    ]
  }
}
