{
  "name": "@opap/installer",
  "version": "0.1.0-beta.1",
  "description": "Auditable setup wizard for Open Personal Agent Platform",
  "author": "Open Personal Agent Platform contributors",
  "private": true,
  "type": "module",
  "main": "dist-main/main.js",
  "opapInstallerTarget": "production",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --external:electron --external:wrangler --outfile=dist-main/main.js --sourcemap && esbuild src/preload.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --outfile=dist-main/preload.cjs --sourcemap",
    "build": "vite build && pnpm build:main",
    "package": "vite build && pnpm build:main && electron-builder",
    "package:test": "vite build && pnpm build:main && electron-builder --config electron-builder.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@opap/secret-vault": "workspace:*",
    "@opap/setup-engine": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wrangler": "^4.125.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "dev.opap.setup",
    "productName": "Open Personal Agent Setup",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "package.json",
      "resources/**/*",
      "!node_modules/**/*",
      "!resources/node-runtime/**/*",
      "!resources/node-runtime-deps/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../../deployments/targets",
        "to": "targets"
      },
      {
        "from": "resources/node-runtime",
        "to": "node-runtime"
      },
      {
        "from": "resources/node-runtime-deps/node_modules",
        "to": "node-runtime/node_modules"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false
    },
    "publish": null
  }
}
