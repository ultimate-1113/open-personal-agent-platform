{
  "name": "open-personal-agent-platform",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm openapi:check && pnpm test && pnpm build",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "openapi:generate": "node --experimental-strip-types scripts/generate-openapi.ts",
    "openapi:check": "node --experimental-strip-types scripts/generate-openapi.ts --check",
    "secret:discord:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-discord-staging-secrets.ps1",
    "sync:discord:commands": "node --experimental-strip-types scripts/sync-discord-commands.ts",
    "verify:execution-lease-keys": "node --experimental-strip-types scripts/verify-execution-lease-keys.ts .wrangler/staging"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "openapi-typescript": "7.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
